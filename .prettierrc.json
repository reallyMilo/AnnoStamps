{
  "$schema": "https://json.schemastore.org/prettierrc",
  "overrides": [{ "files": ".nvmrc", "options": { "parser": "yaml" } }],
  "plugins": [
    "prettier-plugin-curly",
    "prettier-plugin-packagejson",
    "prettier-plugin-sentences-per-line",
    "prettier-plugin-sh",
    "prettier-plugin-tailwindcss"
  ],
  "singleQuote": true
}
