{
  "name": "annostamps",
  "version": "0.0.0",
  "private": true,
  "description": "Community site for sharing stamps in Anno game series.",
  "type": "module",
  "scripts": {
    "analyze-build": "ANALZYE=true pnpm build",
    "build": "next build --webpack",
    "cypress": "cypress open",
    "db-seed": "prisma db seed",
    "dev": "next dev --webpack",
    "lint": "eslint .",
    "lint-ci": "next typegen && eslint . ",
    "migrate": "prisma migrate dev && prisma generate --sql",
    "prepare": "husky",
    "reset-db": "prisma migrate reset",
    "start": "next start",
    "studio": "prisma studio",
    "test": "vitest run",
    "test:e2e": "cypress run --browser chrome",
    "test:watch": "vitest",
    "vitest": "vitest --ui"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1095.0",
