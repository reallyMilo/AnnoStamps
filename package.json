    "@heroicons/react": "^2.2.0",
    "@next/bundle-analyzer": "16.2.12",
    "@next/third-parties": "16.2.12",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@sentry/nextjs": "^10.68.0",
    "@tailwindcss/forms": "^0.5.11",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "fs-extra": "^11.4.0",
    "jszip": "^3.10.1",
    "marked": "^18.0.7",
    "next": "16.2.12",
    "qs": "^6.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-textarea-autosize": "^8.5.9",
    "sanitize-html": "^2.17.6",
    "server-only": "^0.0.1",
    "sharp": "0.32.6",
    "swiper": "12.2.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
